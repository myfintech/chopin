// Pi providers for the MANTL LLM gateway (LiteLLM in front of Vertex AI).
// See docs/pi-providers.md. Select a model with
// MODEL=mantl/<id>, for example MODEL=mantl/claude-opus-5-5.
//
// Sources, checked 2026-10-02:
// - Limits and prices: the gateway's own /model/info, which is what it enforces
//   and bills. Where it is silent, the vendor figure noted on the model.
// - Behavior flags (thinking, temperature, signatures): Pi's newer catalog
//   entries for the same models (@earendil-works/pi-ai 1.0.0).
// Prices are USD per million tokens and only affect Pi's usage reporting.
// Pi sends maxTokens as each request's max_tokens; every value here was
// verified against the gateway.
{
	"providers": {
		"mantl": {
			"name": "MANTL LLM gateway",
			"baseUrl": "${AI_GATEWAY_BASE_URL}",
			"apiKey": "${AI_GATEWAY_API_KEY}",
			// The gateway speaks the Anthropic Messages API for every vendor, as
			// Pi's built-in vercel-ai-gateway catalog does.
			"api": "anthropic-messages",
			"models": [
				{
					"id": "claude-opus-5-5",
					"name": "Claude Opus 5.5",
					"reasoning": true,
					"input": ["text", "image"],
					"contextWindow": 1000000,
					"maxTokens": 128000,
					"cost": { "input": 4, "output": 20, "cacheRead": 0.2, "cacheWrite": 5 },
					"thinkingLevelMap": {
						"off": null,
						"minimal": null,
						"low": "low",
						"medium": "medium",
						"high": "high",
						"xhigh": "xhigh",
						"max": "max",
					},
					"compat": { "forceAdaptiveThinking": true, "supportsTemperature": false },
				},
				{
					"id": "claude-sonnet-5-5",
					"name": "Claude Sonnet 5.5",
					"reasoning": true,
					"input": ["text", "image"],
					"contextWindow": 1000000,
					"maxTokens": 128000,
					"cost": { "input": 2, "output": 10, "cacheRead": 0.2, "cacheWrite": 2.5 },
					"thinkingLevelMap": {
						"off": null,
						"minimal": null,
						"low": "low",
						"medium": "medium",
						"high": "high",
						"xhigh": "xhigh",
						"max": "max",
					},
					"compat": { "forceAdaptiveThinking": true, "supportsTemperature": false },
				},
				{
					"id": "gemini-3.8-flash",
					"name": "Gemini 3.8 Flash",
					"reasoning": true,
					"input": ["text", "image"],
					"contextWindow": 1048576,
					"maxTokens": 65536,
					"cost": { "input": 0.75, "output": 3.75, "cacheRead": 0.075, "cacheWrite": 0 },
					"compat": { "allowEmptySignature": true },
				},
				{
					"id": "gemini-3.5-flash-lite",
					"name": "Gemini 3.5 Flash-Lite",
					"reasoning": true,
					"input": ["text", "image"],
					"contextWindow": 1048576,
					"maxTokens": 65536,
					"cost": { "input": 0.3, "output": 2.5, "cacheRead": 0.03, "cacheWrite": 0 },
					"compat": { "allowEmptySignature": true },
				},
				// Grok 4.6 is disabled: on 2026-10-02 the gateway accepted grok-4.6 requests but
				// never answered (no response within 45-60 s on both /v1/messages and
				// /v1/chat/completions, even for a 1,000-token request). Uncomment once the
				// gateway serves it, then rerun the verification described in the docs.
				// {
				// 	// Context: xAI's published 500K (the gateway reports a generic 524,288).
				// 	// Output above 200K input tokens: xAI's $12 (the gateway lists input only).
				// 	"id": "grok-4.6",
				// 	"name": "Grok 4.6",
				// 	"reasoning": true,
				// 	"input": ["text", "image"],
				// 	"contextWindow": 500000,
				// 	"maxTokens": 128000,
				// 	"cost": {
				// 		"input": 2,
				// 		"output": 6,
				// 		"cacheRead": 0.5,
				// 		"cacheWrite": 0,
				// 		"tiers": [
				// 			{ "inputTokensAbove": 200000, "input": 4, "output": 12, "cacheRead": 1, "cacheWrite": 0 }
				// 		]
				// 	},
				// 	"compat": { "allowEmptySignature": true }
				// },
				{
					// The gateway lists prices but no limits for GLM. Limits are Z.ai's
					// published 1M context and 131,072 output; the cache price is Z.ai's.
					"id": "glm-5.2",
					"name": "GLM 5.2",
					"reasoning": true,
					"input": ["text"],
					"contextWindow": 1048576,
					"maxTokens": 131072,
					"cost": { "input": 1.4, "output": 4.4, "cacheRead": 0.26, "cacheWrite": 0 },
					"compat": { "allowEmptySignature": true },
				},
			],
		},
	},
}
